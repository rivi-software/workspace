# The Worker's secrets, and nothing else: the Deploy to Cloudflare button asks for every name in this file as a secret
# (README, Deploy), with the description `cloudflare.bindings` in package.json gives it. On a Worker deployed from the
# command line, `wrangler secret put <NAME>` sets each one. The public settings are `vars` in wrangler.jsonc; local
# development copies .dev.vars.local.example to .dev.vars instead of this file.
# Required. Signs the session cookies (Better Auth), the file links and every sealed value: `openssl rand -base64 48`.
SESSION_SECRET=
# Optional: importing a Microsoft 365 mailbox (README, Microsoft 365 import). Empty: the import is off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional: Amazon SES (README, Amazon SES). Empty: mail goes out through Cloudflare Email Sending.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
