{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RIVI Workspace",
  "version": "../package.json",
  "identifier": "software.rivi.workspace",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost https:; form-action 'none'",
      "capabilities": [
        "start-page"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "copyright": "\u00a9 RIVI Software and contributors",
    "shortDescription": "RIVI Workspace",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "16.4"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
