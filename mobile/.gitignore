# Cargo's build output, and the schemas and the app commands' permissions tauri-build writes on every build.
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/permissions/autogenerated/
# The Xcode and Gradle projects under src-tauri/gen/ are committed; their build output is not.
/src-tauri/gen/apple/build/
/src-tauri/gen/apple/DerivedData/
/src-tauri/gen/apple/Externals/
/src-tauri/gen/apple/*.xcodeproj/project.xcworkspace/xcuserdata/
/src-tauri/gen/apple/*.xcodeproj/xcuserdata/
/src-tauri/gen/apple/xcuserdata/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/app/.cxx/
/src-tauri/gen/android/app/src/main/jniLibs/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/.idea/
/src-tauri/gen/android/*.iml
/src-tauri/gen/android/app/*.iml
/src-tauri/gen/android/key.properties
